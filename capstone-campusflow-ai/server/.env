# CampusFlow local development environment
# Replace ONLY YOUR_USERNAME and YOUR_PASSWORD with your MongoDB Atlas Database Access credentials.
# Keep this file private. Never share the completed connection string.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@campusflow.q1cffph.mongodb.net/campusflow?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-development-secret
CLIENT_URL=http://localhost:5173
PORT=4000
NODE_ENV=development
MONGO_MAX_POOL_SIZE=20

# Optional. Leave empty until an OpenAI API key is configured locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MONGODB_VECTOR_INDEX=campusflow_vector_index

NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_INTERVAL_MS=300000
